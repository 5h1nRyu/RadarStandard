{
  "name": "radar-standard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc --noEmit",
    "format": "prettier --write src \"tests/*.{ts,mjs}\" \"*.{json,ts,html}\" .github/workflows",
    "format:check": "prettier --check src \"tests/*.{ts,mjs}\" \"*.{json,ts,html}\" .github/workflows",
    "test": "node --experimental-strip-types --test tests/model.test.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
